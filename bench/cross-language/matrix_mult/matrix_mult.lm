# Matrix multiplication — 200x200 dense naive O(n^3)
# Tests: floating point arithmetic, nested loops, list indexing
# NOTE: All row construction is inlined (no helper function calls in while loops)
# due to a VM register clobbering bug with function calls inside while loops.

cell main() -> Null
  let n = 200

  # Build matrix A: A[i][j] = (i*200+j) % 1000 / 1000.0
  let mut a = []
  let mut i = 0
  while i < n
    let mut row = []
    let mut j = 0
    while j < n
      row = append(row, (i * n + j) % 1000 / 1000.0)
      j = j + 1
    end
    a = append(a, row)
    i = i + 1
  end

  # Build matrix B: B[i][j] = (j*200+i) % 1000 / 1000.0
  let mut b = []
  i = 0
  while i < n
    let mut row = []
    let mut j = 0
    while j < n
      row = append(row, (j * n + i) % 1000 / 1000.0)
      j = j + 1
    end
    b = append(b, row)
    i = i + 1
  end

  # Multiply C = A * B — build result row by row
  let mut c = []
  i = 0
  while i < n
    let mut row = []
    let mut j = 0
    while j < n
      let mut sum = 0.0
      let mut k = 0
      while k < n
        sum = sum + a[i][k] * b[k][j]
        k = k + 1
      end
      row = append(row, sum)
      j = j + 1
    end
    c = append(c, row)
    i = i + 1
  end

  # Checksum: sum of all elements
  let mut checksum = 0.0
  i = 0
  while i < n
    let mut j = 0
    while j < n
      checksum = checksum + c[i][j]
      j = j + 1
    end
    i = i + 1
  end

  print("matrix_mult(200): checksum = " + to_string(round(checksum * 1000000.0) / 1000000.0))
  return null
end
