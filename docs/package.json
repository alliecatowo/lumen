{
  "name": "lumen-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "npm run build:wasm && vitepress build .",
    "docs:preview": "vitepress preview .",
    "build:wasm": "if command -v wasm-pack >/dev/null 2>&1; then cd ../rust/lumen-wasm && wasm-pack build --target web --out-dir ../../docs/public/wasm; elif [ -n \"$CI\" ]; then echo \"wasm-pack is required in CI to build docs\" >&2; exit 1; else echo \"wasm-pack not found; skipping local WASM build for docs\"; fi"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "vitepress": "^1.6.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@vue/server-renderer": "3.5.43",
    "codemirror": "^6.0.2",
    "vue": "3.5.43"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
