# Nested loops with constants reused after the inner loop (loop-invariant hoisting).
cell tri(n: Int) -> Int
  let mut total = 0
  let mut i = 0
  while i < n
    let mut j = 0
    while j < i
      total = total + j + 1
      j = j + 1
    end
    total = total + 1
    i = i + 1
  end
  return total
end
cell main() -> Int
  print(tri(10))
  print(tri(100))
  let mut k = 0
  let mut s = 0
  while k < 5
    let mut m = 0
    while m < 3
      s = s + 1
      m = m + 1
    end
    s = s + 10
    k = k + 1
  end
  print(s)
  return tri(30)
end
